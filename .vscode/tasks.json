{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build mininet",
      "type": "shell",
      "command": "zig build install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "base": "$zig",
        "fileLocation": ["relative", "${workspaceFolder}/zig-libs/mininet"]
      },
      "group": "build"
    }
  ]
}
